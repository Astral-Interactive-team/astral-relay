{
  "name": "astral-relay",
  "version": "0.1.0",
  "description": "CLI that builds AstralRelay-Agent.exe, a Discord-controlled Windows remote management agent.",
  "type": "module",
  "bin": {
    "astral-relay": "bin/astral-relay.js"
  },
  "scripts": {
    "dev": "node bin/astral-relay.js",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "commander": "12.1.0",
    "discord.js": "14.27.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "6.23.0"
  },
  "pkg": {
    "targets": ["node24-win-x64"],
    "outputPath": "dist"
  }
}
